    <property name="styleSheet">
      <string>
QWidget {font-family:"Segoe UI"; font-size:14px; color:#173B40;}
QMainWindow, QWidget#centralwidget, QStackedWidget#pages {background:#F0F4F5;}
QFrame#sidebar {background:#173B40; border:none;}
QLabel {background:transparent; border:none;}
QLabel#brandLabel {color:white; font-size:23px; font-weight:600;}
QLabel#sidebarFooter {color:#B8D4D0; font-size:12px;}
QListWidget#navigationList {background:transparent; border:none; outline:none; color:#DCEBE9; font-size:15px;}
QListWidget#navigationList::item {padding:16px 13px; margin:3px 0; border-radius:7px;}
QListWidget#navigationList::item:selected {background:#147D72; color:white;}
QListWidget#navigationList::item:hover {background:#245459;}
QLineEdit {background:#F8FAFB; border:1px solid #C8D5D9; border-radius:6px; padding:8px 10px; selection-background-color:#147D72;}
QLineEdit:focus {border:2px solid #147D72; padding:7px 9px;}
QPushButton {background:#EDF3F4; border:1px solid #CBD8DC; border-radius:6px; padding:8px 14px;}
QPushButton:hover {background:#E0ECEC; border-color:#98B8B3;}
QPushButton:pressed {background:#CDDFDC;}
QPlainTextEdit {background:#F8FAFB; border:1px solid #DDE6E8; border-radius:6px; padding:10px; font-family:"Consolas"; font-size:12px;}
QProgressBar {background:#E8EFEF; border:none; border-radius:4px; min-height:8px; max-height:8px;}
QProgressBar::chunk {background:#147D72; border-radius:4px;}
QStatusBar {background:#F0F4F5; color:#60767A; font-size:12px;}

QScrollArea#contentScrollArea, QWidget#scrollAreaWidgetContents {background:#F0F4F5; border:none;}
QScrollBar:vertical {background:#E6EEEE; width:12px; margin:0;}
QScrollBar::handle:vertical {background:#8CB4AD; min-height:40px; border-radius:5px; margin:2px;}
QScrollBar::handle:vertical:hover {background:#147D72;}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {height:0;}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {background:transparent;}


QGroupBox {background:white; border:1px solid #D7E3E6; border-radius:9px; margin-top:12px; padding:14px 10px 10px;}
QGroupBox::title {subcontrol-origin:margin; left:14px; padding:0 5px; font-weight:600;}
QTableWidget {background:white; alternate-background-color:#F1F7F6; gridline-color:#E1E9E9; border:1px solid #D7E3E6; border-radius:6px; selection-background-color:#D3E8E3; selection-color:#173B40;}
QHeaderView::section {background:#EAF2F2; padding:8px; border:0; border-bottom:1px solid #D7E3E6; font-weight:600;}
QPushButton#analyzeRegions,QPushButton#generateSegments,QPushButton#calculateSNR {background:#147D72; color:white; border-color:#147D72; font-weight:600;}
QComboBox,QDoubleSpinBox {background:#F8FAFB; border:1px solid #C8D5D9; border-radius:6px; padding:6px; min-height:22px;}
QPushButton:disabled {color:#8A9B9F; background:#EDF1F2;}
</string>
