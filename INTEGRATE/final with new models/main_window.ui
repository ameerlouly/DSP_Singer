  <resources />
  <connections>
    <connection>
      <sender>navigationList</sender>
      <signal>currentRowChanged(int)</signal>
      <receiver>pages</receiver>
      <slot>setCurrentIndex(int)</slot>
      <hints>
        <hint type="sourcelabel">
          <x>20</x>
          <y>20</y>
        </hint>
        <hint type="destinationlabel">
          <x>20</x>
          <y>20</y>
        </hint>
      </hints>
    </connection>
    <connection>
      <sender>backToWelcomeButton</sender>
      <signal>clicked(bool)</signal>
      <receiver>appScreens</receiver>
      <slot>setCurrentIndex(int)</slot>
    </connection>
    <connection>
      <sender>backToWelcomeButton</sender>
      <signal>clicked()</signal>
      <receiver>statusbar</receiver>
      <slot>hide()</slot>
    </connection>
    <connection>
      <sender>backToWelcomeButton</sender>
      <signal>clicked()</signal>
      <receiver>stopPlayback</receiver>
      <slot>click()</slot>
    </connection>
    <connection>
      <sender>backToWelcomeButton</sender>
      <signal>clicked()</signal>
      <receiver>enterStudioButton</receiver>
      <slot>setFocus()</slot>
    </connection>
  </connections>
